{
  "__inputs": [
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "2.8.0" }
  ],
  "title": "Geographic / Corridor Analytics",
  "uid": "hz-corridors",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["payments", "corridors", "pacs", "cross-border"],
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Cross-Border Ratio (count, lookback)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A1",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (class) ( count_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | label_format class=\"{{if eq .deb_cc .cred_cc}}domestic{{else}}cross_border{{end}}\" [$__range]) )",
          "legendFormat": "{{class}}"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "class" } },
        { "id": "calculateField", "options": { "mode": "reduceRow", "reduce": { "reducer": "sum" }, "alias": "Total" } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "cross_border", "operator": "/", "right": "Total" }, "alias": "CrossBorder %" } }
      ]
    },
    {
      "type": "barchart",
      "title": "Corridor Value by Route (lookback)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (route) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | unwrap InterbankSettlementAmount [$__range]) )",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 10 Corridors by Value (lookback)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(10, sum by (route) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | unwrap InterbankSettlementAmount [$__range]) ) )",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Corridor Trend — Top 10 Routes (value over time)",
      "gridPos": { "h": 9, "w": 18, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(10, sum by (route) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | unwrap InterbankSettlementAmount [$__interval]) ) )",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Cross-Border vs Domestic (count, lookback)",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 4 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "E",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (class) ( count_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | label_format class=\"{{if eq .deb_cc .cred_cc}}domestic{{else}}cross_border{{end}}\" [$__range]) )",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Corridor Matrix (deb_cc → cred_cc, lookback)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "{{ccy}}" }, "overrides": [] },
      "targets": [
        {
          "refId": "F",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(200, sum by (deb_cc, cred_cc) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | unwrap InterbankSettlementAmount [$__range]) ) )",
          "legendFormat": "{{deb_cc}}->{{cred_cc}}"
        }
      ]
    }
  ],
  "templating": { "list": [] }
}
