{
  "__inputs": [
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "2.8.0" }
  ],
  "title": "Cross-Border Transactions",
  "uid": "hz-xborder",
  "schemaVersion": 38,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "barchart",
      "title": "Event Count: Cross-Border vs Domestic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (class) (\n  count_over_time(\n    {job=\"payments_jsonl\", event_type=\"pacs\"}\n    | label_format class=\"{{if eq .deb_cc .cred_cc}}domestic{{else}}cross_border{{end}}\"\n  [$__interval])\n)",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-Border Value over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (class) (\n  sum_over_time(\n    {job=\"payments_jsonl\", event_type=\"pacs\"}\n    | label_format class=\"{{if eq .deb_cc .cred_cc}}domestic{{else}}cross_border{{end}}\"\n    | json\n    | unwrap InterbankSettlementAmount\n  [$__interval])\n)",
          "legendFormat": "Cross-border total"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 10 Corridors by Value (lookback)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(\n  10,\n  sum by (route) (\n    sum_over_time(\n      {job=\"payments_jsonl\", event_type=\"pacs\"}\n      | json\n      | unwrap InterbankSettlementAmount\n    [$__range])\n  )\n)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Corridor Matrix (Value over lookback)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(200, sum by (deb_cc, cred_cc) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | label_drop ServiceLevelCode,DebtorAgentBICFI,CreditorAgentBICFI,filename,host | json | unwrap InterbankSettlementAmount [$__range]) ) )",
          "legendFormat": "{{deb_cc}}->{{cred_cc}}"
        }
      ],
      "transformations": [
        { "id": "groupBy", "options": { "fields": { "deb_cc": { "aggregations": ["first"], "operation": "groupby" }, "cred_cc": { "aggregations": ["first"], "operation": "groupby" }, "Value": { "aggregations": ["lastNotNull"], "operation": "aggregate" } }, "rowLimit": 5000 } }
      ]
    }
  ],
  "templating": { "list": [] }
}
