  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Net Liquidity by Currency (CRDT − DBIT) — Today",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\",event_type=\"camt\",Status=\"BOOK\",CreditDebitIndicator=\"CRDT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__interval] ) )",
          "legendFormat": "CRDT {{ccy}}",
          "hide": false
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\",event_type=\"camt\",Status=\"BOOK\",CreditDebitIndicator=\"DBIT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__interval] ) )",
          "legendFormat": "DBIT {{ccy}}",
          "hide": false
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "ccy" } },
        { "id": "merge", "options": {} },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": { "left": "CRDT .*", "operator": "-", "right": "DBIT .*" },
            "alias": "Net"
          }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Liquidity by DebtorName & Currency (CRDT and DBIT totals)",
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 0 },
      "options": { "showHeader": true, "footer": { "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false } },
      "targets": [
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum_over_time( {job=\"payments_jsonl\",event_type=\"camt\",Status=\"BOOK\",CreditDebitIndicator=\"CRDT\"}\n| json\n| line_format \"{{.DebtorName}}|{{.Currency}}|{{.Amount}}\"\n| regexp \"(?P<DebtorName>.*)\\|(?P<Currency>[A-Z]{3})\\|(?P<CRDT>[0-9]+(?:\\.[0-9]+)?)\"\n| unwrap CRDT [$__range])",
          "legendFormat": "CRDT"
        },
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum_over_time( {job=\"payments_jsonl\",event_type=\"camt\",Status=\"BOOK\",CreditDebitIndicator=\"DBIT\"}\n| json\n| line_format \"{{.DebtorName}}|{{.Currency}}|{{.Amount}}\"\n| regexp \"(?P<DebtorName>.*)\\|(?P<Currency>[A-Z]{3})\\|(?P<DBIT>[0-9]+(?:\\.[0-9]+)?)\"\n| unwrap DBIT [$__range])",
          "legendFormat": "DBIT"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "groupBy", "options": { "fields": { "DebtorName": { "aggregations": ["first"], "operation": "groupby" }, "Currency": { "aggregations": ["first"], "operation": "groupby" }, "CRDT": { "aggregations": ["sum"], "operation": "aggregate" }, "DBIT": { "aggregations": ["sum"], "operation": "aggregate" } }, "rowLimit": 5000 } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "CRDT", "operator": "-", "right": "DBIT" }, "alias": "Net" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [{ "matcher": { "id": "byName", "options": "CRDT" }, "properties": [{ "id": "unit", "value": "currency" }] }, { "matcher": { "id": "byName", "options": "DBIT" }, "properties": [{ "id": "unit", "value": "currency" }] }, { "matcher": { "id": "byName", "options": "Net" }, "properties": [{ "id": "unit", "value": "currency" }] }] }
    },
    {
