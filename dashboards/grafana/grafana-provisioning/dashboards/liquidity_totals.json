{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "2.8.0" }
  ],
  "title": "Liquidity & Treasury",
  "uid": "hz-liquidity-treasury",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["payments", "liquidity", "treasury", "camt", "pacs"],
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Net Liquidity (All currencies) — CRDT − DBIT (lookback)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "A1",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"CRDT\"} | json | unwrap Amount [$__range]) )",
          "legendFormat": "CRDT"
        },
        {
          "refId": "A2",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"DBIT\"} | json | unwrap Amount [$__range]) )",
          "legendFormat": "DBIT"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "Metric" } },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "CRDT", "operator": "-", "right": "DBIT" }, "alias": "Net" } }
      ]
    },
    {
      "type": "table",
      "title": "Liquidity by Currency (CRDT, DBIT, Net)",
      "gridPos": { "h": 8, "w": 10, "x": 6, "y": 0 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "CRDT" }, "properties": [{ "id": "unit", "value": "currency" }] },
          { "matcher": { "id": "byName", "options": "DBIT" }, "properties": [{ "id": "unit", "value": "currency" }] },
          { "matcher": { "id": "byName", "options": "Net" }, "properties": [{ "id": "unit", "value": "currency" }] }
        ]
      },
      "targets": [
        {
          "refId": "B1",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"CRDT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__range]) )",
          "legendFormat": "CRDT {{ccy}}"
        },
        {
          "refId": "B2",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"DBIT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__range]) )",
          "legendFormat": "DBIT {{ccy}}"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "ccy" } },
        { "id": "merge", "options": {} },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "CRDT .*", "operator": "-", "right": "DBIT .*" }, "alias": "Net" } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Net", "desc": true }] } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Daily Liquidity Trend by Currency (CRDT − DBIT)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" }, "stacking": { "mode": "normal", "group": "A" } },
      "targets": [
        {
          "refId": "C1",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"CRDT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__interval]) )",
          "legendFormat": "CRDT {{ccy}}"
        },
        {
          "refId": "C2",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"DBIT\"} | json | label_format ccy=\"{{.Currency}}\" | unwrap Amount [$__interval]) )",
          "legendFormat": "DBIT {{ccy}}"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "CRDT .*", "operator": "-", "right": "DBIT .*" }, "alias": "Net {{ccy}}" } }
      ]
    },
    {
      "type": "table",
      "title": "Net Position per Bank (BIC) — Incoming − Outgoing (lookback)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "unit": "currency" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Net" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text", "mode": "gradient", "color": { "mode": "palette-classic" } } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "D_in",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (bic) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | label_format bic=\"{{.CreditorAgentBICFI}}\" | unwrap InterbankSettlementAmount [$__range]) )",
          "legendFormat": "IN {{bic}}"
        },
        {
          "refId": "D_out",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (bic) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | label_format bic=\"{{.DebtorAgentBICFI}}\" | unwrap InterbankSettlementAmount [$__range]) )",
          "legendFormat": "OUT {{bic}}"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "bic" } },
        { "id": "merge", "options": {} },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "IN .*", "operator": "-", "right": "OUT .*" }, "alias": "Net" } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Net", "desc": true }] } }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 10 Outflows (DBIT) by Debtor BIC",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "E",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(10, sum by (DebtorAgentBICFI) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"DBIT\"} | json | unwrap Amount [$__range]) ) )",
          "legendFormat": "{{DebtorAgentBICFI}}"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Top 10 Inflows (CRDT) by Creditor BIC",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currency" }, "overrides": [] },
      "targets": [
        {
          "refId": "F",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "topk(10, sum by (CreditorAgentBICFI) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"CRDT\"} | json | unwrap Amount [$__range]) ) )",
          "legendFormat": "{{CreditorAgentBICFI}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "FX Mix (by InterbankSettlementCurrency, PACS)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "G",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (fx) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"pacs\"} | json | label_format fx=\"{{.InterbankSettlementCurrency}}\" | unwrap InterbankSettlementAmount [$__range]) )",
          "legendFormat": "{{fx}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "BIC × Currency — Liquidity Matrix (Net over lookback)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 17 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "unit": "currency" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Net" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text", "mode": "gradient", "color": { "mode": "palette-classic" } } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "H1",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (bic, ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"CRDT\"} | json | label_format bic=\"{{.DebtorAgentBICFI}}\",ccy=\"{{.Currency}}\" | unwrap Amount [$__range]) )",
          "legendFormat": "CRDT {{bic}} {{ccy}}"
        },
        {
          "refId": "H2",
          "datasource": { "type": "loki", "uid": "DS_LOKI" },
          "expr": "sum by (bic, ccy) ( sum_over_time( {job=\"payments_jsonl\", event_type=\"camt\", Status=\"BOOK\", CreditDebitIndicator=\"DBIT\"} | json | label_format bic=\"{{.DebtorAgentBICFI}}\",ccy=\"{{.Currency}}\" | unwrap Amount [$__range]) )",
          "legendFormat": "DBIT {{bic}} {{ccy}}"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "bic" } },
        { "id": "merge", "options": {} },
        { "id": "calculateField", "options": { "mode": "binary", "binary": { "left": "CRDT .*", "operator": "-", "right": "DBIT .*" }, "alias": "Net" } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Net", "desc": true }] } }
      ]
    }
  ],
  "templating": { "list": [] }
}
